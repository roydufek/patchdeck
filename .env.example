# Required: 32+ char random string. Encrypts SSH credentials at rest (AES-GCM).
PATCHDECK_MASTER_KEY=replace-with-32plus-char-random-string

# Optional:
#PATCHDECK_PORT=6070
#PATCHDECK_TLS=true                                  # set false if behind a TLS-terminating reverse proxy
#REGISTRATION_ENABLED=true                           # set false to block first-run admin bootstrap (e.g. once set up)
#PATCHDECK_SSH_TIMEOUT_SECONDS=20                    # SSH dial/handshake timeout
#PATCHDECK_EXEC_TIMEOUT_SECONDS=600                  # max wall-clock for a remote command (scan/apply)
#PATCHDECK_CONNECTIVITY_TIMEOUT_SECONDS=15           # live dashboard connectivity check timeout
#PATCHDECK_APPRISE_URL=tgram://bot_token/chat_id     # notification target
